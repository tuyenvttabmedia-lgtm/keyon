# Copy → .env.local (dev) hoặc .env.production (VPS)
# Next.js: .env.local ưu tiên hơn .env trên localhost

NODE_ENV=development

# Database
DATABASE_URL=postgresql://keyon:keyon@localhost:5432/keyon?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# SEO: production + non-localhost APP_URL mới cho index. Force noindex: SEO_NOINDEX=true
# SEO_NOINDEX=true
SESSION_SECRET=dev-change-me-keyon-session-secret-32chars
DELIVERY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Payment: stub | sepay | payos | megapay
# Ưu tiên: Admin → Cài đặt → SePay (provider ≠ stub) rồi ENV.
# CRITICAL: production MUST NOT use stub (stub-confirm can mark paid without bank).
PAYMENT_PROVIDER=stub

# SePay — Admin cấu hình khuyến nghị; ENV là fallback theo từng field
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_BIN=
SEPAY_BANK_NAME=
SEPAY_BANK_DISPLAY_NAME=
SEPAY_ACCOUNT_NAME=
SEPAY_QR_TEMPLATE=compact2
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
# Webhook URL: {NEXT_PUBLIC_APP_URL}/api/webhooks/sepay
PAYMENT_EXPIRE_MS=900000

# Policy (optional overrides)
POLICY_SLA_INSTANT=
POLICY_SLA_MANUAL=
POLICY_RESEND_MAX=5
POLICY_WARRANTY_DAYS=7
POLICY_INBOX_HOURS=
# Mail — Admin → Cài đặt → Email / SMTP ưu tiên khi provider = brevo|custom.
# ENV dùng khi provider = env (mặc định) hoặc fallback field trống.
# Brevo: SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 SMTP_USER=<login> SMTP_PASS=<smtp-key>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="KEYON <noreply@keyon.local>"
MAIL_REPLY_TO=
# Storage: local | wasabi
# Ưu tiên cấu hình Admin → Cài đặt → Storage / Wasabi.
# ENV dùng fallback / ops khi admin chưa cấu hình.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage/uploads
WASABI_ENDPOINT=
WASABI_REGION=
WASABI_BUCKET=
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=
WASABI_PUBLIC_BASE_URL=
WASABI_PATH_PREFIX=media

# License Pool
LICENSE_RESERVE_TTL=15m
LICENSE_TTL_SWEEP_MS=30000

# Supplier API — Admin → Cài đặt → NCC / Pax8 (ưu tiên); ENV fallback theo field
PAX8_DRIVER=stub
PAX8_BASE_URL=
PAX8_CLIENT_ID=
PAX8_CLIENT_SECRET=
PAX8_COMPANY_ID=
# PACISOFT (reserved — MANUAL_OPS hiện tại)
PACISOFT_ENABLED=
PACISOFT_BASE_URL=
PACISOFT_API_KEY=

# Logging
LOG_LEVEL=info
