    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "seed:demo-ops": "tsx --env-file=.env.local --env-file=.env prisma/seed-demo-ops.ts",
    "db:studio": "prisma studio",
    "test:license-pool": "tsx --env-file=.env.local --env-file=.env scripts/license-pool-exit.ts",
    "test:inventory": "tsx --env-file=.env.local --env-file=.env scripts/inventory-exit.ts",
    "test:sepay": "tsx --env-file=.env.local --env-file=.env scripts/sepay-exit.ts",
    "test:monitoring": "tsx --env-file=.env.local --env-file=.env scripts/monitoring-exit.ts",
    "test:dashboard": "tsx --env-file=.env.local --env-file=.env scripts/dashboard-exit.ts",
