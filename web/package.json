    "test:backup": "tsx --env-file=.env.local --env-file=.env scripts/backup-exit.ts",
    "test:internal": "tsx --env-file=.env.local --env-file=.env scripts/internal-test-exit.ts",
    "test:pax8": "tsx --env-file=.env.local --env-file=.env scripts/pax8-exit.ts",
    "test:org": "tsx --env-file=.env.local --env-file=.env scripts/org-exit.ts",
    "pilot:snapshot": "tsx --env-file=.env.local --env-file=.env scripts/pilot-snapshot.ts"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
