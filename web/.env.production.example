# Template production — copy to server as .env.production (KHÔNG commit secrets thật)
NODE_ENV=production
DATABASE_URL=postgresql://keyon:CHANGE_ME@postgres:5432/keyon?schema=public
REDIS_URL=redis://redis:6379
NEXT_PUBLIC_APP_URL=https://your-domain.com
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_32PLUS
DELIVERY_ENCRYPTION_KEY=REPLACE_WITH_32PLUS_RANDOM_CHARS
PAYMENT_PROVIDER=sepay
# SePay sandbox — IPN: https://your-domain.com/api/webhooks/sepay · auth API Key
SEPAY_MERCHANT_CODE=SP-TEST-YOUR_CODE
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_BIN=
SEPAY_BANK_NAME=
SEPAY_BANK_DISPLAY_NAME=
SEPAY_ACCOUNT_NAME=KEYON
SEPAY_QR_TEMPLATE=compact2
PAYMENT_EXPIRE_MS=900000

SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="KEYON <noreply@your-domain.com>"
STORAGE_DRIVER=wasabi
STORAGE_LOCAL_ROOT=/var/keyon/uploads
WASABI_ENDPOINT=https://s3.ap-southeast-1.wasabisys.com
WASABI_REGION=ap-southeast-1
WASABI_BUCKET=keyon-prod
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Used by compose.prod.yaml
POSTGRES_USER=keyon
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=keyon
